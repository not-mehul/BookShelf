{
  "name": "bookshelf",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Personal catalog for books, movies, TV, and quotes — Editorial Dusk & Dawn",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "android:assets": "vite build && node scripts/sync-android-assets.mjs",
    "typecheck": "tsc -p .",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
