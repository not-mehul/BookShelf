{
  "name": "bookshelf",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Personal catalog for books, movies, TV, and quotes — Editorial Dusk & Dawn",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node design/build-tokens.mjs --check && npm run lint && npm run typecheck && npm run test && npm run build",
    "android:assets": "vite build && node scripts/sync-android-assets.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test",
    "tokens": "node design/build-tokens.mjs --css src/styles/tokens.css --fonts src/styles/fonts"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
