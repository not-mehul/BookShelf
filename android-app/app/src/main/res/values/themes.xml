<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No ActionBar; the web app renders its own chrome. Dusk-colored window so
         the brief pre-WebView frame matches the app instead of flashing white. -->
    <style name="Theme.BookShelf" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dusk_bg</item>
        <item name="android:statusBarColor">@color/dusk_bg</item>
        <item name="android:navigationBarColor">@color/dusk_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
